
# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearup?schema=public

# ---------- JWT ----------
JWT_SECRET=replace-me-with-a-32-character-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-me-with-a-different-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ---------- Bcrypt ----------
BCRYPT_SALT_ROUNDS=10

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me


# ---------- Logging ----------
LOG_LEVEL=debug
LOG_PRETTY=true

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- Admin Seeding ----------
ADMIN_EMAIL=admin@gearup.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=GearUp Administrator
