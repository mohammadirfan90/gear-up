{
  "info": {
    "_postman_id": "gearup-collection-001",
    "name": "GearUp API",
    "description": "Sports & outdoor equipment rental marketplace backend. Covers authentication, public catalog browsing, customer rental flow, provider inventory management, Stripe payment integration, post-rental reviews, and admin moderation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "providerId", "value": "", "type": "string" },
    { "key": "adminId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "gearItemId", "value": "", "type": "string" },
    { "key": "rentalOrderId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Returns service uptime and timestamp. No auth required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.tokens && r.data.tokens.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', r.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', r.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('customerId', r.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice.customer@example.com\",\n  \"password\": \"CustomerPass123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new customer. Stores tokens and user id in collection variables."
          },
          "response": []
        },
        {
          "name": "Register Provider",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.tokens && r.data.tokens.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', r.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', r.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('providerId', r.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Outdoor Gear\",\n  \"email\": \"bob.provider@example.com\",\n  \"password\": \"ProviderPass123!\",\n  \"role\": \"provider\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new provider (gear vendor)."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.tokens) {",
                  "  pm.collectionVariables.set('accessToken', r.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', r.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('userId', r.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.customer@example.com\",\n  \"password\": \"CustomerPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate with email/password and receive access + refresh JWTs. Suspended accounts get 403."
          },
          "response": []
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.tokens) {",
                  "  pm.collectionVariables.set('accessToken', r.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('adminId', r.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gearup.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate with the seeded admin credentials from .env.example."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', r.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Exchange a valid refresh token for a fresh access token pair."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the authenticated user's profile. Suspended accounts get 403."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Invalidates the current refresh token (server-side revocation). Auth required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Public listing of all gear categories. No auth required."
          },
          "response": []
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [
                { "key": "id", "value": "{{categoryId}}" }
              ]
            },
            "description": "Public lookup of a single category by cuid."
          },
          "response": []
        },
        {
          "name": "Create Category (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.id) {",
                  "  pm.collectionVariables.set('categoryId', r.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Camping\",\n  \"slug\": \"camping\",\n  \"description\": \"Tents, sleeping bags, cookware, and outdoor camping essentials.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Create a new category. Admin role required. Slug must be unique."
          },
          "response": []
        },
        {
          "name": "Update Category (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description for the camping category.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [
                { "key": "id", "value": "{{categoryId}}" }
              ]
            },
            "description": "Update a category. Admin role required."
          },
          "response": []
        },
        {
          "name": "Delete Category (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [
                { "key": "id", "value": "{{categoryId}}" }
              ]
            },
            "description": "Delete a category. Admin role required. Refuses if any gear is still linked."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gear Catalog",
      "item": [
        {
          "name": "List Gear (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gear?page=1&limit=20&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["gear"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "categoryId", "value": "{{categoryId}}", "disabled": true },
                { "key": "brand", "value": "", "disabled": true },
                { "key": "priceMin", "value": "", "disabled": true },
                { "key": "priceMax", "value": "", "disabled": true },
                { "key": "isAvailable", "value": "true", "disabled": true },
                { "key": "providerId", "value": "", "disabled": true },
                { "key": "search", "value": "", "disabled": true },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            },
            "description": "Public gear catalog with filtering, search, and sorting. No auth required. Response includes average rating and review count per item."
          },
          "response": []
        },
        {
          "name": "Get Gear by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gear/:id",
              "host": ["{{baseUrl}}"],
              "path": ["gear", ":id"],
              "variable": [
                { "key": "id", "value": "{{gearItemId}}" }
              ]
            },
            "description": "Get full gear details with category, provider, and aggregated ratings."
          },
          "response": []
        },
        {
          "name": "Provider: Create Gear",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.id) {",
                  "  pm.collectionVariables.set('gearItemId', r.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"4-Person Dome Tent\",\n  \"description\": \"Waterproof family-sized dome tent suitable for 3-season camping. Quick-pitch design.\",\n  \"brand\": \"NorthRidge\",\n  \"pricePerDay\": 24.50,\n  \"stock\": 8,\n  \"isAvailable\": true,\n  \"images\": [\"https://example.com/photos/tent-1.jpg\"],\n  \"specifications\": {\n    \"capacity\": \"4 people\",\n    \"weight_kg\": 3.4,\n    \"seasons\": \"3-season\"\n  },\n  \"categoryId\": \"{{categoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/provider/gear",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "gear"]
            },
            "description": "Provider: add a new gear item to your inventory. Stores the new gear id for follow-up calls."
          },
          "response": []
        },
        {
          "name": "Provider: Update Gear",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerDay\": 27.00,\n  \"stock\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/provider/gear/:id",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "gear", ":id"],
              "variable": [
                { "key": "id", "value": "{{gearItemId}}" }
              ]
            },
            "description": "Provider: partial update of your own gear. Returns 403 if the gear belongs to another provider."
          },
          "response": []
        },
        {
          "name": "Provider: Update Gear (PUT alias)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/provider/gear/:id",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "gear", ":id"],
              "variable": [
                { "key": "id", "value": "{{gearItemId}}" }
              ]
            },
            "description": "PUT alias for the PATCH update — same controller handler."
          },
          "response": []
        },
        {
          "name": "Provider: Delete Gear",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/provider/gear/:id",
              "host": ["{{baseUrl}}"],
              "path": ["provider", "gear", ":id"],
              "variable": [
                { "key": "id", "value": "{{gearItemId}}" }
              ]
            },
            "description": "Provider: delete your gear. If the gear is referenced by any past order, the API falls back to soft-delete (sets isAvailable=false and stock=0) instead of throwing."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rentals",
      "item": [
        {
          "name": "Create Rental Order (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.id) {",
                  "  pm.collectionVariables.set('rentalOrderId', r.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-08-10\",\n  \"endDate\": \"2026-08-13\",\n  \"items\": [\n    { \"gearItemId\": \"{{gearItemId}}\", \"quantity\": 1 }\n  ],\n  \"notes\": \"Pickup at store front please.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals",
              "host": ["{{baseUrl}}"],
              "path": ["rentals"]
            },
            "description": "Customer creates a new rental order. Performs date validation, self-rental check, stock availability check, and atomic stock decrement in a single transaction."
          },
          "response": []
        },
        {
          "name": "List My Rentals (Customer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rentals?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["rentals"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "", "disabled": true }
              ]
            },
            "description": "Customer: list your own rental orders. Optional status filter."
          },
          "response": []
        },
        {
          "name": "Get Rental by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rentals/:id",
              "host": ["{{baseUrl}}"],
              "path": ["rentals", ":id"],
              "variable": [
                { "key": "id", "value": "{{rentalOrderId}}" }
              ]
            },
            "description": "Get a single rental order. Customer sees own, provider sees own-gear orders, admin sees all."
          },
          "response": []
        },
        {
          "name": "Update Rental Status (Customer cancel)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\",\n  \"reason\": \"Plans changed.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["rentals", ":id", "status"],
              "variable": [
                { "key": "id", "value": "{{rentalOrderId}}" }
              ]
            },
            "description": "Customer can cancel their own order if it's still in placed/confirmed/paid status. Restores stock on cancellation."
          },
          "response": []
        },
        {
          "name": "Provider: List Incoming Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/provider/orders?page=1&limit=20",
