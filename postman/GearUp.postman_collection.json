    {
      "name": "Payments (Stripe)",
      "item": [
        {
          "name": "Create Payment Intent (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.paymentId) {",
                  "  pm.collectionVariables.set('paymentId', r.data.paymentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalOrderId\": \"{{rentalOrderId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/create",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "create"]
            },
            "description": "Create a Stripe PaymentIntent for a rental order. Recomputes amount server-side; idempotent (returns existing pending payment on repeat calls). Returns clientSecret for the frontend to confirm the card."
          },
          "response": []
        },
        {
          "name": "Webhook (Stripe → server)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "stripe-signature", "value": "{{stripeSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_001\",\n  \"object\": \"event\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"{{stripePaymentIntentId}}\",\n      \"metadata\": { \"rentalOrderId\": \"{{rentalOrderId}}\" }\n    }\n  }\n}"
            },
            "url": {
