
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User role. Customers and providers self-register; admins are seeded.
enum Role {
  customer
  provider
  admin
}

/// User account status. Admins can suspend/activate.
enum UserStatus {
  active
  suspended
}


enum OrderStatus {
  placed
  confirmed
  paid
  picked_up
  returned
  cancelled
}


enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentProvider {
  stripe
  sslcommerz
}


model User {
  id           String     @id @default(cuid())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  password     String     
  refreshToken String?    
  role         Role
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?  

  // Relations
  gearItems        GearItem[]           @relation("ProviderGear")
  rentalOrders     RentalOrder[]        @relation("CustomerRentals")
  payments         Payment[]
  reviews          Review[]
  statusChanges    RentalStatusHistory[] @relation("StatusChanger")

  // Indexes
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}


model Category {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  gearItems GearItem[]

  @@index([name])
  @@map("categories")
}


model GearItem {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(200)
  description    String   @db.Text
  brand          String   @db.VarChar(100)
  pricePerDay    Decimal  @db.Decimal(10, 2)
  stock          Int      @default(0)
  isAvailable    Boolean  @default(true)
  images         String[] // array of image URLs
  specifications Json?    
  categoryId     String
  providerId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime? 

  // Relations
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  provider    User         @relation("ProviderGear", fields: [providerId], references: [id], onDelete: Restrict)
  rentalItems RentalItem[]
  reviews     Review[]


  @@index([categoryId])
  @@index([providerId])
  @@index([pricePerDay])
  @@index([isAvailable])
  @@index([brand])
  @@index([createdAt])
  @@map("gear_items")
}


model RentalOrder {
  id          String      @id @default(cuid())
  customerId  String
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(placed)
  notes       String?     @db.VarChar(500)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  customer      User                   @relation("CustomerRentals", fields: [customerId], references: [id], onDelete: Restrict)
  items         RentalItem[]
  payments      Payment[]
  reviews       Review[]
  statusHistory RentalStatusHistory[]

  // Indexes
  @@index([customerId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdAt])
  @@map("rental_orders")
}

model RentalItem {
  id            String  @id @default(cuid())
  rentalOrderId String
  gearItemId    String
  quantity      Int     // units rented
  pricePerDay   Decimal @db.Decimal(10, 2)  // snapshot of gear price at order time
  subtotal      Decimal @db.Decimal(10, 2)  // pricePerDay * quantity * days

  // Relations
  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  gearItem    GearItem    @relation(fields: [gearItemId], references: [id], onDelete: Restrict)

  // One line per gear per order (prevent duplicate lines)
  @@unique([rentalOrderId, gearItemId])
  @@index([gearItemId])
  @@map("rental_items")
}


model Payment {
  id            String          @id @default(cuid())
  rentalOrderId String
  userId        String          // who paid (the customer)
  transactionId String          @unique // Stripe PaymentIntent ID
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("usd") @db.VarChar(3)
  method        String?         @db.VarChar(50)   // e.g. "card"
  provider      PaymentProvider
  status        PaymentStatus   @default(pending)
  paidAt        DateTime?
  failureReason String?         @db.VarChar(500)
  metadata      Json?           // raw Stripe response / webhook payload
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([rentalOrderId])
  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@map("payments")
}


model Review {
  id            String   @id @default(cuid())
  rentalOrderId String   @unique // enforces one-per-rental at DB level
  gearItemId    String
  customerId    String
  rating        Int      // 1..5 (validated at app layer via Zod)
  comment       String?  @db.VarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  gearItem    GearItem    @relation(fields: [gearItemId], references: [id], onDelete: Cascade)
  customer    User        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Indexes — for aggregating ratings per gear
  @@index([gearItemId])
  @@index([customerId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}


model RentalStatusHistory {
  id            String       @id @default(cuid())
  rentalOrderId String
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedById   String       // userId of actor (customer/provider/admin)
  reason        String?      @db.VarChar(500)
  changedAt     DateTime     @default(now())

  // Relations
  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("StatusChanger", fields: [changedById], references: [id], onDelete: Restrict)

  // Indexes — for chronological order queries
  @@index([rentalOrderId, changedAt])
  @@index([changedById])
  @@map("rental_status_history")
}